<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dexter_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/dexter_speech_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="260dp"
        android:background="@drawable/bg_speech_bubble"
        android:paddingLeft="14dp"
        android:paddingTop="8dp"
        android:paddingRight="14dp"
        android:paddingBottom="8dp"
        android:layout_marginBottom="6dp"
        android:text="Jenna &amp; Dexter Online"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="visible" />

    <ImageView
        android:id="@+id/dexter_avatar"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/dexter_pet"
        android:scaleType="fitCenter"
        android:contentDescription="Dexter Screen Pet" />

</LinearLayout>
