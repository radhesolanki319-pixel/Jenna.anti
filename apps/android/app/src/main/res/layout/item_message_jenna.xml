<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start|top"
    android:paddingStart="4dp"
    android:paddingEnd="40dp"
    android:paddingVertical="6dp">

    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/nexa_avatar"
        android:contentDescription="NEXA" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_nexa_bot_bubble"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEXA"
            android:textColor="#FFFF2B85"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_jenna_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="NEXA response"
            android:textColor="#FFF5F3FA"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.25" />

    </LinearLayout>
</LinearLayout>
