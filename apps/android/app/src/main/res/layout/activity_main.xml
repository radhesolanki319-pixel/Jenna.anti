<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fitsSystemWindows="true">

    <!-- ================================================================ -->
    <!-- 1. TOP CYBER HEADER BAR                                          -->
    <!-- ================================================================ -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- Glowing Mini Avatar -->
        <ImageView
            android:id="@+id/header_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_jenna_avatar" />

        <!-- Title & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jenna"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Online Pulse Dot -->
                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_badge_live" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="LIVE"
                    android:textColor="@color/accent_green"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Companion • GPT-6 Astra"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Live Battery & Thermal Telemetry Pill -->
        <TextView
            android:id="@+id/header_battery_badge"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip_luxury"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="⚡ 24% • 36.6°C"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Quick Dexter Overlay Button -->
        <ImageView
            android:id="@+id/btn_header_dexter"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_luxury"
            android:padding="6dp"
            android:src="@drawable/dexter_pet" />
    </LinearLayout>

    <!-- Thin Glass Divider -->
    <View
        android:id="@+id/header_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/header_bar"
        android:background="#1A38BDF8" />

    <!-- ================================================================ -->
    <!-- 2. MAIN CONTENT VIEW CONTAINER (4 TAB SCREENS)                  -->
    <!-- ================================================================ -->
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_nav_bar"
        android:layout_below="@id/header_divider">

        <!-- ============================================================ -->
        <!-- SCREEN 1: COMPANION CHAT WORKSPACE                          -->
        <!-- ============================================================ -->
        <RelativeLayout
            android:id="@+id/screen_chat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <!-- TOP 52%: LIVING CHARACTER AVATAR STAGE -->
            <RelativeLayout
                android:id="@+id/stage_companion_container"
                android:layout_width="match_parent"
                android:layout_height="330dp"
                android:layout_alignParentTop="true"
                android:background="#FF050711">

                <!-- Living Character Portrait Image -->
                <ImageView
                    android:id="@+id/character_avatar_stage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/jenna_character_stage" />

                <!-- Bottom Fade Gradient Overlay for Seamless Transition -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_alignParentBottom="true"
                    android:background="@drawable/bg_stage_fade" />

                <!-- Floating Glass Dialogue Pill Capsule -->
                <LinearLayout
                    android:id="@+id/dialogue_capsule_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_dialogue_pill"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp">

                    <!-- Title Row with Glowing Live Dot -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_badge_live" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="JENNA AI • HERMES SYNC"
                            android:textColor="@color/accent_cyan"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Intimate Subtitle Spoken Text -->
                    <TextView
                        android:id="@+id/text_companion_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Boss, I am fully connected to your iQOO Neo 10 &amp; Snapdragon 8 Gen 4. How can I serve you today?"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Neon Cyan Animated Audio Waveform -->
                    <ai.jenna.app.views.AudioWaveformView
                        android:id="@+id/companion_audio_wave"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- BOTTOM 48%: HIGH-TECH CYBER-DECK DASHBOARD -->
            <ScrollView
                android:id="@+id/chat_scroll_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@id/composer_container"
                android:layout_below="@id/stage_companion_container"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp">

                    <!-- Twin Hardware Telemetry HUD Gauges + Dexter Card Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Gauge 1: Snapdragon 8 Gen 4 CPU -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="116dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_glass_card"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <ai.jenna.app.views.CircularGaugeView
                                android:id="@+id/gauge_dash_cpu"
                                android:layout_width="72dp"
                                android:layout_height="72dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="SD 8 Gen 4 • 4.32GHz"
                                android:textColor="@color/accent_orange"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Gauge 2: Battery Bypass 84% -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="116dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_glass_card"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <ai.jenna.app.views.CircularGaugeView
                                android:id="@+id/gauge_dash_battery"
                                android:layout_width="72dp"
                                android:layout_height="72dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="BYPASS ACTIVE"
                                android:textColor="@color/accent_green"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Card 3: Dexter Pet Quick Card -->
                        <LinearLayout
                            android:id="@+id/card_dash_dexter"
                            android:layout_width="0dp"
                            android:layout_height="116dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_glass_card_glow"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/dexter_pet" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Dexter Pet"
                                android:textColor="@color/text_primary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tap to Spawn"
                                android:textColor="@color/accent_purple"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Horizontal Suggestion Chips -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chip_how_are_you"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_chip_luxury"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="✨ Kaise ho Boss?"
                                android:textColor="@color/text_primary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_check_battery"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_chip_luxury"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="⚡ Bypass Status"
                                android:textColor="@color/text_primary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_spawn_dexter"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_chip_luxury"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="🐾 Spawn Dexter"
                                android:textColor="@color/text_primary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_pulse_pointer"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_chip_luxury"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="👆 Pulse Pointer"
                                android:textColor="@color/text_primary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_open_web"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:background="@drawable/bg_chip_luxury"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="🌐 Web Hub"
                                android:textColor="@color/text_primary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Message Feed / Recent Dialogue Container -->
                    <LinearLayout
                        android:id="@+id/chat_messages_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>

            <!-- Bottom Floating Sunken Message Bar -->
            <LinearLayout
                android:id="@+id/composer_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_bottom_nav"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">

                    <ImageView
                        android:id="@+id/btn_voice_mic"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/transparent"
                        android:padding="8dp"
                        android:src="@drawable/ic_mic" />

                    <EditText
                        android:id="@+id/input_chat_message"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="6dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Talk to Jenna..."
                        android:imeOptions="actionSend"
                        android:inputType="textCapSentences"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/btn_send_chat"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_button_gradient"
                        android:padding="8dp"
                        android:src="@drawable/ic_send" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- ============================================================ -->
        <!-- SCREEN 2: DEXTER SCREEN COMPANION STUDIO                    -->
        <!-- ============================================================ -->
        <ScrollView
            android:id="@+id/screen_dexter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Dexter Hero Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card_glow"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:src="@drawable/dexter_pet" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Dexter Screen Companion"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_dexter_status_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Floating pet overlay with active speech bubble and touch pointer."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- Spawn / Hide Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_toggle_dexter_main"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_gradient"
                            android:text="Spawn Dexter"
                            android:textAllCaps="false"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_pulse_pointer_main"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_luxury"
                            android:text="Pulse Pointer"
                            android:textAllCaps="false"
                            android:textColor="@color/accent_cyan"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Dexter Dialogue Quick Triggers -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quick Pet Dialogues"
                        android:textColor="@color/accent_purple"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_dexter_say_protect"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_chip_luxury"
                        android:gravity="center_vertical|start"
                        android:paddingHorizontal="14dp"
                        android:text="🐾 'Phone safe hai Boss, main screen pe hu!'"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btn_dexter_say_sleep"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_chip_luxury"
                        android:gravity="center_vertical|start"
                        android:paddingHorizontal="14dp"
                        android:text="🌙 'Main 24/7 yahi hoon Boss, so jao aaram se.'"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btn_dexter_say_cool"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_chip_luxury"
                        android:gravity="center_vertical|start"
                        android:paddingHorizontal="14dp"
                        android:text="⚡ 'Bypass active hai Boss, phone bilkul cool hai.'"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ============================================================ -->
        <!-- SCREEN 3: CYBERDECK (HARDWARE & BYPASS HUD)                 -->
        <!-- ============================================================ -->
        <ScrollView
            android:id="@+id/screen_cyber"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Twin Circular HUD Gauges Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card_glow"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Real-Time Hardware Telemetry"
                        android:textColor="@color/accent_cyan"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ai.jenna.app.views.CircularGaugeView
                            android:id="@+id/gauge_battery"
                            android:layout_width="120dp"
                            android:layout_height="120dp" />

                        <View
                            android:layout_width="16dp"
                            android:layout_height="1dp" />

                        <ai.jenna.app.views.CircularGaugeView
                            android:id="@+id/gauge_temperature"
                            android:layout_width="120dp"
                            android:layout_height="120dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Power Bypass Schematic Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Bypass Power Governance"
                            android:textColor="@color/accent_green"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_bypass_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_live"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="BYPASS ACTIVE"
                            android:textColor="@color/accent_green"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Animated Schematic Circuit -->
                    <ai.jenna.app.views.BypassFlowView
                        android:id="@+id/bypass_flow_view"
                        android:layout_width="match_parent"
                        android:layout_height="85dp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Charger direct Snapdragon ko power supply karta hai taaki battery 0% degrade ho aur phone thanda rahe."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 24/7 Lifeline & Autonomous Accessibility Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24/7 Daemon &amp; Accessibility"
                        android:textColor="@color/accent_purple"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_toggle_lifeline_hub"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_button_gradient"
                        android:text="24/7 Lifeline Service Active"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_accessibility_hub"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_chip_luxury"
                        android:text="Accessibility Granted (Autonomous Control)"
                        android:textAllCaps="false"
                        android:textColor="@color/accent_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Backend & Web Companion Bridge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Antigravity 2.0 &amp; Hermes Swarm Bridge"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

