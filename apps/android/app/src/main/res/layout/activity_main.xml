<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fitsSystemWindows="true">

    <!-- 1. TOP STATUS / HEADER BAR -->
    <RelativeLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentTop="true"
        android:background="#E6080C1A"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/header_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_jenna_avatar"
            android:contentDescription="Jenna Avatar" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/header_avatar"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JENNA AI"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_badge_live" />

                <TextView
                    android:id="@+id/text_header_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Snapdragon 8 Gen 4 • 144Hz"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quick Header Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <!-- 144Hz Refresh Button -->
            <Button
                android:id="@+id/btn_quick_refresh"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_chip_luxury"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="⚡ 144Hz"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Dexter Companion Overlay Toggle -->
            <Button
                android:id="@+id/btn_quick_dexter"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_luxury"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="🐾 HUD"
                android:textColor="@color/accent_pink"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Terminal Button -->
            <Button
                android:id="@+id/btn_quick_terminal"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_luxury"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="💻 Sh"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. QUICK SHORTCUT CHIPS (Horizontal Scroll) -->
    <HorizontalScrollView
        android:id="@+id/chips_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_bar"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chip_status"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_luxury"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="📊 System Status"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_battery"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_luxury"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="🔋 Battery &amp; Thermals"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_storage"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_luxury"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="💾 Storage Space"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_voice_toggle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_luxury"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="🔊 Voice: ON"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_clear_chat"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_luxury"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="🗑️ Clear View"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 3. COMPOSER DOCK (Pinned to Bottom) -->
    <RelativeLayout
        android:id="@+id/composer_dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_glass_card_glow"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <ImageView
            android:id="@+id/btn_voice_mic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voice Input"
            android:padding="8dp"
            android:src="@drawable/ic_mic" />

        <EditText
            android:id="@+id/input_chat_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="6dp"
            android:layout_toStartOf="@+id/btn_send_chat"
            android:layout_toEndOf="@id/btn_voice_mic"
            android:background="@null"
            android:hint="Message Jenna or type '!command'..."
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:paddingVertical="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btn_send_chat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_button_gradient"
            android:contentDescription="Send"
            android:padding="10dp"
            android:src="@drawable/ic_send" />
    </RelativeLayout>

    <!-- 4. CHAT MESSAGES SCROLL VIEW (Between Chips & Composer) -->
    <ScrollView
        android:id="@+id/chat_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/composer_dock"
        android:layout_below="@id/chips_scroll"
        android:clipToPadding="false"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:paddingHorizontal="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/dynamic_messages_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</RelativeLayout>
