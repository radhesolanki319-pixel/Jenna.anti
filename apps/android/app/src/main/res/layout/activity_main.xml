<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF08070D"
    android:fitsSystemWindows="true">

    <!-- ================================================================ -->
    <!-- 1. NEXA ONBOARDING / SPLASH SCREEN                               -->
    <!-- ================================================================ -->
    <RelativeLayout
        android:id="@+id/layout_nexa_splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- Fullscreen Cyberpunk Splash Art -->
        <ImageView
            android:id="@+id/img_nexa_splash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/nexa_splash_screen" />

        <!-- Floating Get Started CTA Button -->
        <Button
            android:id="@+id/btn_get_started"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="28dp"
            android:layout_marginBottom="44dp"
            android:background="@drawable/bg_nexa_btn_gradient"
            android:text="Get Started  →"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- ================================================================ -->
    <!-- 2. NEXA COMPANION CHAT WORKSPACE                                 -->
    <!-- ================================================================ -->
    <RelativeLayout
        android:id="@+id/layout_nexa_chat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- HEADER BAR -->
        <LinearLayout
            android:id="@+id/nexa_header_bar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_alignParentTop="true"
            android:background="#E608070D"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <!-- Back Arrow -->
            <ImageView
                android:id="@+id/btn_chat_back"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:padding="4dp"
                android:src="@drawable/ic_nexa_arrow_back" />

            <!-- Glowing Circular Companion Avatar -->
            <ImageView
                android:id="@+id/nexa_chat_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/nexa_avatar" />

            <!-- Name & Status -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NEXA"
                        android:textColor="#FFFF2B85"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Your AI Companion"
                        android:textColor="#FFAAA5B8"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_live" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Online"
                        android:textColor="#FF10B981"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="どんな未来でも、一緒に。 ALWAYS WITH YOU."
                    android:textColor="#66AAA5B8"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Action: Notes / Canvas -->
            <ImageView
                android:id="@+id/btn_nexa_notes"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:src="@drawable/ic_nexa_note" />

            <!-- Action: Settings -->
            <ImageView
                android:id="@+id/btn_nexa_settings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:src="@drawable/ic_nexa_settings" />
        </LinearLayout>

        <!-- Subtle Pink Glowing Divider -->
        <View
            android:id="@+id/nexa_header_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/nexa_header_bar"
            android:background="#33FF2B85" />

        <!-- CHAT FEED SCROLLVIEW -->
        <ScrollView
            android:id="@+id/chat_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/nexa_bottom_dock"
            android:layout_below="@id/nexa_header_divider"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chat_messages_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="18dp">

                <!-- 1. Companion Welcome Bubble -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/nexa_avatar" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_nexa_bot_bubble"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hey there, Senpai! 👋\nWhat's on your mind today?"
                            android:textColor="#FFF5F3FA"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2. User Question Bubble -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_nexa_user_bubble"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Plan a 3-day trip to Tokyo for me ✈"
                            android:textColor="#FFF5F3FA"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 3. Companion Response Bubble -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/nexa_avatar" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_nexa_bot_bubble"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Got it! Here's your 3-day Tokyo itinerary — a mix of culture, food, and hidden gems. ♡"
                            android:textColor="#FFF5F3FA"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 4. Interactive Tokyo Itinerary Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="44dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_nexa_card"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Tokyo Banner Image -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/nexa_tokyo_banner" />

                    <!-- Day 1 Accordion -->
                    <LinearLayout
                        android:id="@+id/card_day_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_nexa_day_card"
                        android:clickable="true"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🏛 Day 1 — Classic Tokyo  ▼"
                            android:textColor="#FF00F5D4"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/desc_day_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="• Asakusa: Historic Senso-ji Temple &amp; traditional street food\n• Akihabara: Anime tech &amp; retro gaming district\n• Sumida River: Evening cruise &amp; Tokyo Skytree view"
                            android:textColor="#FFAAA5B8"
                            android:textSize="12sp"
                            android:visibility="visible" />
                    </LinearLayout>

                    <!-- Day 2 Accordion -->
                    <LinearLayout
                        android:id="@+id/card_day_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_nexa_day_card"
                        android:clickable="true"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🏢 Day 2 — Modern &amp; Trendy  ▼"
                            android:textColor="#FF00F5D4"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/desc_day_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="• Harajuku &amp; Meiji Jingu: Fashion &amp; serene shrines\n• Shibuya Sky: 360° observatory &amp; Shibuya Crossing\n• Shinjuku: Omoide Yokocho izakaya street"
                            android:textColor="#FFAAA5B8"
                            android:textSize="12sp"
                            android:visibility="visible" />
                    </LinearLayout>

                    <!-- Day 3 Accordion -->
                    <LinearLayout
                        android:id="@+id/card_day_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_nexa_day_card"
                        android:clickable="true"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⛰ Day 3 — Hidden Gems  ▼"
                            android:textColor="#FF00F5D4"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/desc_day_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="• Yanaka Ginza: Old-world downtown Tokyo cats &amp; alleys\n• Shimokitazawa: Indie vinyl shops &amp; aesthetic cafes\n• Roppongi Hills: Sunset panorama &amp; modern art"
                            android:textColor="#FFAAA5B8"
                            android:textSize="12sp"
                            android:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 5. User Follow-up Bubble -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_nexa_user_bubble"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="That's perfect! Can you suggest some aesthetic cafes too? ☕"
                            android:textColor="#FFF5F3FA"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 6. Companion Follow-up Bubble -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/nexa_avatar" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_nexa_bot_bubble"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Of course! Here are some must-visit cafes in Tokyo: Fuglen Tokyo, Reissue (3D Latte Art), and Aoyama Flower Market Tea House. ♡"
                            android:textColor="#FFF5F3FA"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Dynamic Live Chat Messages Container -->
                <LinearLayout
                    android:id="@+id/dynamic_messages_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </ScrollView>

        <!-- BOTTOM DOCK & FOOTER -->
        <LinearLayout
            android:id="@+id/nexa_bottom_dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#F208070D"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <!-- Capsule Input Bar -->
            <LinearLayout
                android:id="@+id/composer_container"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_nexa_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <!-- Plus Button -->
                <ImageView
                    android:id="@+id/btn_dock_plus"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_nexa_plus" />

                <!-- Text Input -->
                <EditText
                    android:id="@+id/input_chat_message"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Type a message..."
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="3"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#66AAA5B8"
                    android:textSize="14sp" />

                <!-- Gallery Image Button -->
                <ImageView
                    android:id="@+id/btn_dock_gallery"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_nexa_gallery" />

                <!-- Voice Mic Button -->
                <ImageView
                    android:id="@+id/btn_voice_mic"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_mic" />

                <!-- Circular Glowing Send Button -->
                <ImageView
                    android:id="@+id/btn_send_chat"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_nexa_send_btn"
                    android:clickable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_send" />
            </LinearLayout>

            <!-- Sub-dock Tagline -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:text="THINK. CREATE. MOVE FORWARD.  ネクサ"
                android:textColor="#4DFFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

    </RelativeLayout>
</RelativeLayout>
