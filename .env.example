# ===========================
# Jenna AI — Environment Configuration
# ===========================
# Copy this file to .env and update values.
# NEVER commit the .env file.

# Application
APP_ENV=development
APP_SECRET=change-me-to-a-random-secret
SESSION_SECRET=change-me-to-a-random-secret
LOG_LEVEL=INFO

# Database (PostgreSQL)
POSTGRES_USER=jenna
POSTGRES_PASSWORD=jenna_secret
POSTGRES_DB=jenna_db
DATABASE_URL=postgresql+asyncpg://jenna:jenna_secret@localhost:5432/jenna_db

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# AI Provider Configuration (Part 2)
# Supported providers: gemini, openai
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
AI_REQUEST_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=2
